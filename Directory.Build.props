<Project>
  <PropertyGroup>
    <ProductVersionFile>$(MSBuildThisFileDirectory)VERSION</ProductVersionFile>
    <Version Condition="'$(Version)' == ''">$([System.IO.File]::ReadAllText('$(ProductVersionFile)').Trim())</Version>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Authors>nekoimi and contributors</Authors>
    <Copyright>Original work © 2026 CSXizhang and contributors. Modifications © 2026 nekoimi and contributors.</Copyright>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
