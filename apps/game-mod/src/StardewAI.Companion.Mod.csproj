<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StardewAI.Companion.Mod</AssemblyName>
    <RootNamespace>StardewAI.Companion.Mod</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Releases omit debugger artifacts, including the absolute CodeView PDB path in the DLL. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <StardewGamePath Condition="'$(StardewGamePath)' == ''">$(STARDEW_GAME_PATH)</StardewGamePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../shared/dotnet/FileLogger.cs" Link="Logging/FileLogger.cs" />
    <Reference Include="SMAPI.Toolkit.CoreInterfaces">
      <HintPath>$(StardewGamePath)\smapi-internal\SMAPI.Toolkit.CoreInterfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(StardewGamePath)\smapi-internal\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="StardewModdingAPI" Condition="Exists('$(StardewGamePath)\StardewModdingAPI.dll')">
      <HintPath>$(StardewGamePath)\StardewModdingAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Stardew Valley" Condition="Exists('$(StardewGamePath)\Stardew Valley.dll')">
      <HintPath>$(StardewGamePath)\Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework" Condition="Exists('$(StardewGamePath)\MonoGame.Framework.dll')">
      <HintPath>$(StardewGamePath)\MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="xTile" Condition="Exists('$(StardewGamePath)\xTile.dll')">
      <HintPath>$(StardewGamePath)\xTile.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="StardewValley.GameData" Condition="Exists('$(StardewGamePath)\StardewValley.GameData.dll')">
      <HintPath>$(StardewGamePath)\StardewValley.GameData.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="GenerateModManifest" BeforeTargets="Build">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\manifest.template.json">
      <Output TaskParameter="Lines" ItemName="ManifestTemplateLines" />
    </ReadLinesFromFile>
    <ItemGroup>
      <ManifestOutputLines Include="@(ManifestTemplateLines)">
        <Text>$([System.String]::Copy('%(Identity)').Replace('__VERSION__', '$(Version)'))</Text>
      </ManifestOutputLines>
    </ItemGroup>
    <WriteLinesToFile File="$(TargetDir)manifest.json" Lines="@(ManifestOutputLines->'%(Text)')" Overwrite="true" Encoding="UTF-8" />
  </Target>

  <Target Name="ValidateStardewGamePath" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(StardewGamePath)\StardewModdingAPI.dll')">
    <Error Text="STARDEW_GAME_PATH must point to a Stardew Valley installation containing StardewModdingAPI.dll." />
  </Target>
</Project>
