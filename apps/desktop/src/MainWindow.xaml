<Window x:Class="StardewAI.Companion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StardewAI.Companion.Desktop"
        Title="星露谷游戏伴侣" Icon="Assets/companion.ico" Width="1080" Height="745" MinWidth="780" MinHeight="575"
        WindowStartupLocation="CenterScreen" Background="{StaticResource RoomBackground}" Foreground="{StaticResource Ink}"
        FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:TimelineEntry}">
            <Border Background="#FFFCF5" BorderBrush="#E5D8BC" BorderThickness="1"
                    CornerRadius="6" Padding="11,7" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Pine}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource RoomSidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource RoomAgentSlotHeight}" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="2" Background="{StaticResource Pine}" BorderBrush="#193426" BorderThickness="0,0,0,2" Padding="15,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionText" Text="等待启动游戏" Foreground="#F3E2B8" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="LaunchHeader" Content="启动游戏" Click="LaunchClicked" Style="{StaticResource HeaderButton}" />
                    <Button x:Name="ReconnectHeader" Content="重连伙伴服务" Click="ReconnectClicked" Visibility="Collapsed"
                            Style="{StaticResource HeaderButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="33" Height="33" Background="{StaticResource Gold}" BorderBrush="#F7DBA5"
                            BorderThickness="1" CornerRadius="7" Margin="0,0,10,0">
                        <Path Data="M 10,19 L 10,10 M 10,13 C 5,13 3,11 3,6 C 8,6 10,8 10,12 M 10,10 C 10,5 13,3 18,3 C 18,8 15,10 10,10 M 5,19 L 15,19"
                              Stroke="{StaticResource Pine}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="星露谷游戏伴侣" Foreground="#FFF7E5" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="Pages" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Style="{StaticResource RoomTabs}"
                    SelectionChanged="SaveViewSelected">
            <TabItem x:Name="CommandPage" Header="今天" Tag="&#xE80F;" Style="{StaticResource RoomPage}">
                <Border BorderBrush="{StaticResource PaperEdge}" BorderThickness="1" Background="{StaticResource Pine}" CornerRadius="10">
                    <Grid Margin="6">
                        <Grid.Background>
                            <ImageBrush ImageSource="Assets/farm.png" Stretch="UniformToFill" Viewbox="0.12,0,0.84,1" />
                        </Grid.Background>
                        <RenderOptions.BitmapScalingMode>NearestNeighbor</RenderOptions.BitmapScalingMode>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="132" MaxHeight="228" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                                    <GradientStop Color="#E4214231" Offset="0" />
                                    <GradientStop Color="#A0214231" Offset="0.38" />
                                    <GradientStop Color="#00214231" Offset="0.79" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="17,14,15,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="172" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Top" Margin="0,7,12,0">
                                <TextBlock Text="今天一起照料农场" Foreground="#FFF7E4" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="有什么想让伙伴帮忙？" Foreground="#FFF1CF" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource PagePaper}" Padding="11,9" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="当前安排" Foreground="{StaticResource Pine}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TodayGoalText" Text="进入存档后可查看。" FontSize="12" Margin="0,5,0,3"
                                               Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="36" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button Content="查看农场工作" Click="OpenWorkClicked" HorizontalAlignment="Left" Margin="0,4,0,0"
                                            MinHeight="25" Padding="6,2" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="15,0,15,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" MaxWidth="700" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PagePaper}" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="和伙伴聊聊" Foreground="{StaticResource Pine}" FontWeight="SemiBold" Margin="0,0,0,7" />
                                    <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <StackPanel>
                                            <TextBlock x:Name="TimelineHint" Text="进入存档后，就可以在这里交代农活或和伙伴聊天。"
                                                       Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" Margin="0,0,0,6">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasItems, ElementName=Timeline}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl x:Name="Timeline" />
                                            <Border x:Name="DecisionPanel" Background="#E8EDDC" CornerRadius="5" Padding="10" Margin="0,4,0,6" Visibility="Collapsed">
                                                <StackPanel>
                                                    <ComboBox x:Name="DecisionPicker" DisplayMemberPath="Title" SelectedValuePath="Id"
                                                              AutomationProperties.Name="待确认事项" SelectionChanged="DecisionSelected" Margin="0,0,0,6" />
                                                    <TextBlock x:Name="DecisionText" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    <WrapPanel x:Name="DecisionChoices" />
                                                    <DockPanel LastChildFill="True" Margin="0,5,0,0">
                                                        <Button x:Name="DecisionReplyButton" Content="回复此事项" DockPanel.Dock="Right"
                                                                Click="DecisionReplyClicked" Margin="8,0,0,0" />
                                                        <Button x:Name="DismissDecisionButton" Content="关闭事项" DockPanel.Dock="Right"
                                                                Click="DismissDecisionClicked" Margin="8,0,0,0" />
                                                        <TextBox x:Name="DecisionInput" MaxLength="500" AutomationProperties.Name="自定义回复" />
                                                    </DockPanel>
                                                    <TextBlock x:Name="DecisionFeedback" Foreground="#537261" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox x:Name="Input" AutomationProperties.Name="发送给伴侣的指令"
                                                     MaxLength="500" MinHeight="39" MaxHeight="72" TextWrapping="Wrap"
                                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputKeyDown" />
                                            <TextBlock Text="告诉伙伴接下来做什么" Foreground="{StaticResource MutedInk}"
                                                       FontSize="12" Margin="10,8,6,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Text, ElementName=Input}" Value="" />
                                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=Input}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="9,0,0,0">
                                            <Button x:Name="SendButton" Content="发送" Click="SendClicked" ToolTip="Ctrl+Enter"
                                                    Style="{StaticResource PrimaryButton}" />
                                            <Button x:Name="InterruptButton" Content="打断并执行" Click="InterruptClicked" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                        <WrapPanel.Resources>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="MinHeight" Value="27" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Padding" Value="8,3" />
                                                <Setter Property="Margin" Value="0,0,6,3" />
                                            </Style>
                                        </WrapPanel.Resources>
                                        <Button x:Name="AuthorityButton" Click="AuthorityClicked" Content="交给 AI" />
                                        <Button x:Name="PauseButton" Tag="pause" Click="ControlClicked" Content="暂停" />
                                        <Button x:Name="ResumeButton" Tag="resume" Click="ControlClicked" Content="继续" />
                                        <Button x:Name="CancelButton" Tag="cancel" Click="ControlClicked" Content="取消当前工作" />
                                        <Button x:Name="RecoverButton" Tag="recover" Click="ControlClicked" Content="核对旧动作" Visibility="Collapsed" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem x:Name="WorkPage" Header="农场工作" Tag="&#xE9F5;" Style="{StaticResource RoomPage}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,14,0">
                        <TextBlock DockPanel.Dock="Top" Text="进行中的目标" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button DockPanel.Dock="Bottom" x:Name="WithdrawGoalButton" Content="撤回所选目标" Margin="0,8,0,0"
                                HorizontalAlignment="Left" IsEnabled="False" Click="WithdrawGoalClicked" />
                        <ListBox x:Name="GoalPicker" AutomationProperties.Name="进行中的目标" SelectionChanged="GoalSelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,4">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Foreground="#537261" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,7,0">
                        <StackPanel>
                            <TextBlock x:Name="WorkStatus" TextWrapping="Wrap" Margin="0,0,0,9" />
                            <TextBlock x:Name="WorkFeedback" TextWrapping="Wrap" Foreground="#537261" />
                            <ItemsControl x:Name="WorkDetails" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="MilestonesPage" Header="计划" Tag="&#xE787;" Style="{StaticResource RoomPage}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <TextBlock x:Name="MilestoneStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ListBox x:Name="MilestonePicker" DisplayMemberPath="Label" AutomationProperties.Name="计划节点"
                                 SelectionChanged="MilestoneSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
                            <Button x:Name="AdoptMilestoneButton" Tag="adopt" Content="采纳计划" Click="MilestoneClicked" />
                            <Button x:Name="DeferMilestoneButton" Tag="defer" Content="暂缓计划" Click="MilestoneClicked" />
                        </WrapPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="MilestoneDetails" />
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="HistoryPage" Header="对话历史" Tag="&#xE81C;" Style="{StaticResource RoomPage}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="HistoryRefreshButton" Content="读取最新" Click="RefreshHistoryClicked" />
                        <Button x:Name="HistoryOlderButton" Content="查看更早记录" Click="OlderHistoryClicked" />
                    </WrapPanel>
                    <TextBlock x:Name="HistoryStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl x:Name="HistoryEntries" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="MessagesPage" Header="伙伴消息" Tag="&#xE715;" Style="{StaticResource RoomPage}">
                <TabControl x:Name="MessageViews" Padding="8" SelectionChanged="SaveViewSelected">
                    <TabItem x:Name="CarePage" Header="提醒">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button x:Name="RefreshMessagesButton" Content="读取最新" Click="RefreshMessagesClicked" />
                                <Button x:Name="OlderMessagesButton" Content="查看更早消息" Click="OlderMessagesClicked" />
                                <Button x:Name="ReadMessageButton" Content="将所选消息标为已读" Click="ReadMessageClicked" />
                                <Button Content="查看计划" Click="OpenMilestonesClicked" />
                            </WrapPanel>
                            <TextBlock x:Name="MessagesStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ListBox x:Name="MessagePicker" SelectionChanged="MessageSelected" AutomationProperties.Name="存档提醒"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3,4">
                                            <TextBlock Text="{Binding Label}" Foreground="#537261" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="已关闭事项">
                        <DockPanel>
                            <TextBlock x:Name="ClosedDecisionStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button x:Name="RestoreDecisionButton" Content="恢复所选事项" DockPanel.Dock="Bottom" Click="RestoreDecisionClicked"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <ListBox x:Name="ClosedDecisionPicker" SelectionChanged="ClosedDecisionSelected" AutomationProperties.Name="已关闭事项"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="3,4" /></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem x:Name="MemoryPage" Header="手记" Tag="&#xE82D;" Style="{StaticResource RoomPage}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,14,0">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button x:Name="ReadMemoryButton" Content="读取记忆" Click="ReadMemoryClicked" />
                            <Button x:Name="NewMemoryButton" Content="新增记忆" Click="NewMemoryClicked" />
                        </WrapPanel>
                        <ListBox x:Name="MemoryPicker" AutomationProperties.Name="当前存档的记忆"
                                 SelectionChanged="MemorySelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="3,4">
                                        <TextBlock Text="{Binding Label}" Foreground="#537261" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="MemoryFeedback" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="记忆类型" Margin="0,0,0,4" />
                        <ComboBox x:Name="MemoryKind" SelectedValuePath="Tag" AutomationProperties.Name="记忆类型" Margin="0,0,0,8">
                            <ComboBoxItem Content="偏好" Tag="preference" />
                            <ComboBoxItem Content="约定" Tag="agreement" />
                            <ComboBoxItem Content="共同经历" Tag="event" IsEnabled="False" />
                        </ComboBox>
                        <TextBox x:Name="MemoryText" AutomationProperties.Name="记忆内容" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="80" MaxHeight="166" MaxLength="200" VerticalScrollBarVisibility="Auto" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="SaveMemoryButton" Content="保存记忆" Click="SaveMemoryClicked" />
                            <Button x:Name="DeleteMemoryButton" Content="删除所选记忆" Click="DeleteMemoryClicked" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="SettingsPage" Header="设置" Tag="&#xE713;" Style="{StaticResource RoomPage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8" MaxWidth="670">
                        <StackPanel x:Name="SettingsFields">
                            <TextBlock Text="游戏目录" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DockPanel Margin="0,0,0,15">
                                <Button DockPanel.Dock="Right" Content="选择…" Click="BrowseGame" Margin="8,0,0,0" />
                                <TextBox x:Name="GameFolder" AutomationProperties.Name="游戏目录" />
                            </DockPanel>
                            <TextBlock Text="游玩方式" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="Mode" Width="220" HorizontalAlignment="Left" Margin="0,0,0,15">
                                <ComboBoxItem Content="伙伴模式" Tag="companion" />
                                <ComboBoxItem Content="AI 自己玩（单人）" Tag="player" />
                            </ComboBox>
                            <TextBlock Text="伙伴来源" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="PartnerSource" SelectedValuePath="Tag" SelectionChanged="PartnerSourceSelected"
                                      AutomationProperties.Name="伙伴来源" Margin="0,0,0,13">
                                <ComboBoxItem Content="启动本机模型客户端" Tag="builtin" />
                                <ComboBoxItem Content="接续原 MiniMax Code 会话" Tag="external" />
                            </ComboBox>
                            <StackPanel x:Name="BuiltinFields">
                                <TextBlock Text="模型客户端" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox x:Name="BackendPicker" SelectedValuePath="Id" DisplayMemberPath="Name" SelectionChanged="BackendSelected"
                                          AutomationProperties.Name="模型客户端" Margin="0,0,0,13" />
                                <TextBlock Text="模型" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox x:Name="Model" AutomationProperties.Name="模型" />
                                <TextBlock x:Name="ModelHint" Foreground="#537261" Margin="0,3,0,13" TextWrapping="Wrap" />
                                <TextBlock Text="推理档位" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox x:Name="ReasoningEffort" AutomationProperties.Name="推理档位" Margin="0,0,0,13" />
                                <TextBlock Text="客户端路径" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="选择…" Click="BrowseClient" Margin="8,0,0,0" />
                                    <TextBox x:Name="ClientPath" AutomationProperties.Name="客户端路径" />
                                </DockPanel>
                                <TextBlock Text="留空自动检测。请先在原客户端登录。" Foreground="#537261" Margin="0,3,0,12" />
                            </StackPanel>
                            <Button Content="保存启动设置" Click="SaveClicked" HorizontalAlignment="Left" />
                            <Separator Margin="0,13" />
                            <TextBlock Text="旧安装数据" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBlock x:Name="ImportFeedback" Text="退出游戏后，可从原伙伴 Mod 目录导入数据。" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <CheckBox x:Name="ImportDataOnly" Content="仅导入数据，沿用此包的伙伴接入设置" Margin="0,0,0,8" />
                            <Button x:Name="ImportButton" Content="从原安装导入…" Click="ImportClicked" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel x:Name="OriginalFields" Visibility="Collapsed">
                            <Separator Margin="0,13" />
                            <TextBlock Text="原 MiniMax Code 会话" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <TextBlock x:Name="OriginalFeedback" Text="启动游戏后，可在这里列出并接续原会话。" TextWrapping="Wrap" Margin="0,0,0,9" />
                            <TextBlock Text="原工作目录" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,9">
                                <Button DockPanel.Dock="Right" Content="选择…" Click="BrowseOriginalWorkspace" Margin="8,0,0,0" />
                                <TextBox x:Name="OriginalWorkspace" AutomationProperties.Name="原工作目录" TextChanged="OriginalLocationChanged" />
                            </DockPanel>
                            <TextBlock Text="原数据目录（使用默认目录可留空）" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,9">
                                <Button DockPanel.Dock="Right" Content="选择…" Click="BrowseOriginalData" Margin="8,0,0,0" />
                                <TextBox x:Name="OriginalData" AutomationProperties.Name="原数据目录" TextChanged="OriginalLocationChanged" />
                            </DockPanel>
                            <TextBlock Text="MiniMax Code 客户端路径（可留空）" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,9">
                                <Button DockPanel.Dock="Right" Content="选择…" Click="BrowseOriginalClient" Margin="8,0,0,0" />
                                <TextBox x:Name="OriginalClient" AutomationProperties.Name="MiniMax Code 客户端路径" TextChanged="OriginalLocationChanged" />
                            </DockPanel>
                            <Button x:Name="ListSessionsButton" Content="列出原会话" Click="ListOriginalSessions" HorizontalAlignment="Left" />
                            <ListBox x:Name="OriginalSessions" DisplayMemberPath="Label" AutomationProperties.Name="原会话"
                                     SelectionChanged="OriginalSelectionChanged" Margin="0,6,0,9" MinHeight="32" MaxHeight="144" />
                            <TextBlock Text="游戏显示名（可留空）" Margin="0,0,0,4" />
                            <TextBox x:Name="OriginalName" AutomationProperties.Name="原伙伴显示名" MaxLength="80" Margin="0,0,0,9" />
                            <CheckBox x:Name="OriginalIdle" Content="连接期间保持原聊天窗口闲置" Margin="0,0,0,9"
                                      Checked="OriginalSelectionChanged" Unchecked="OriginalSelectionChanged" />
                            <WrapPanel>
                                <Button x:Name="AttachPartner" Content="接续所选会话" Click="AttachOriginalPartner" />
                                <Button x:Name="DisconnectPartner" Content="断开桌面连接" Click="DisconnectOriginalPartner" />
                                <Button x:Name="SavePartnerLocation" Content="保存原会话目录" Click="SaveOriginalLocation" />
                            </WrapPanel>
                        </StackPanel>
                        <Separator Margin="0,13" />
                        <TextBlock Text="当前存档的伙伴设置" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7" />
                        <TextBlock x:Name="ProfileFeedback" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button x:Name="ReadProfileButton" Content="重新读取伙伴设置" HorizontalAlignment="Left" Click="ReadProfileClicked" />
                        <StackPanel x:Name="ProfileFields" Margin="0,8,0,0">
                            <StackPanel x:Name="CompanionIdentityFields">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="伙伴名字" Margin="0,0,0,4" />
                                    <TextBox x:Name="CompanionName" MaxLength="12" AutomationProperties.Name="伙伴名字" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="相处方向" Margin="0,0,0,4" />
                                    <ComboBox x:Name="PlayStyle" SelectedValuePath="Tag" AutomationProperties.Name="相处方向">
                                        <ComboBoxItem Content="赚钱" Tag="earn" />
                                        <ComboBoxItem Content="干活" Tag="workhorse" />
                                        <ComboBoxItem Content="社区" Tag="community" />
                                        <ComboBoxItem Content="布置" Tag="decor" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="性格" Margin="0,0,0,4" />
                                    <ComboBox x:Name="Personality" SelectedValuePath="Tag" AutomationProperties.Name="性格">
                                        <ComboBoxItem Content="温柔" Tag="gentle" />
                                        <ComboBoxItem Content="活泼" Tag="lively" />
                                        <ComboBoxItem Content="沉稳" Tag="calm" />
                                        <ComboBoxItem Content="嘴硬心软" Tag="tsundere" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="交流频率" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CareFrequency" SelectedValuePath="Tag" AutomationProperties.Name="交流频率">
                                        <ComboBoxItem Content="安静" Tag="quiet" />
                                        <ComboBoxItem Content="适中" Tag="moderate" />
                                        <ComboBoxItem Content="健谈" Tag="chatty" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="就寝时间" Margin="0,0,0,4" />
                                    <ComboBox x:Name="Bedtime" AutomationProperties.Name="就寝时间" />
                                </StackPanel>
                            </UniformGrid>
                            <Button x:Name="SaveProfileButton" Content="保存伙伴设置" HorizontalAlignment="Left" Click="SaveProfileClicked" />
                            </StackPanel>
                            <Separator Margin="0,12" />
                            <CheckBox x:Name="Initiative" Content="空闲时主动帮忙" Margin="0,0,0,8" />
                            <TextBlock Text="主动帮忙时的偏好" Margin="0,0,0,4" />
                            <ComboBox x:Name="IdlePreference" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag"
                                      AutomationProperties.Name="主动帮忙时的偏好" Margin="0,0,0,9">
                                <ComboBoxItem Content="由伙伴安排" Tag="autonomous" />
                                <ComboBoxItem Content="清理障碍" Tag="clear" />
                                <ComboBoxItem Content="采集" Tag="forage" />
                                <ComboBoxItem Content="采木" Tag="wood" />
                                <ComboBoxItem Content="原地等待" Tag="wait" />
                            </ComboBox>
                            <Button x:Name="SaveInitiativeButton" Content="保存主动帮忙设置" HorizontalAlignment="Left" Click="SaveInitiativeClicked" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="UsagePage" Header="用量" Tag="&#xE9D9;" Style="{StaticResource RoomPage}">
                <DockPanel Margin="4">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="RefreshUsageButton" Content="刷新用量" Click="RefreshUsageClicked"
                                HorizontalAlignment="Left" />
                        <TextBlock x:Name="UsageStatus" TextWrapping="Wrap" Foreground="#537261" Margin="0,4,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="UsageEntries" AutomationProperties.Name="模型用量汇总" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="DiagnosticsPage" Header="诊断" Tag="&#xE90F;" Style="{StaticResource RoomPage}">
                <TextBox x:Name="Diagnostics" AutomationProperties.Name="运行日志" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="4" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Style="{StaticResource PagePaper}" Padding="10,7"
                Margin="12,0,13,14" VerticalAlignment="Bottom">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <Border DockPanel.Dock="Left" Background="#EED09A" BorderBrush="{StaticResource PaperEdge}"
                            BorderThickness="1" CornerRadius="5" Width="32" Height="32" Margin="0,0,9,0">
                        <Image Source="Assets/portrait.png" Margin="2" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Agent 状态" Foreground="{StaticResource MutedInk}" FontSize="11" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#678948" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AgentStateText}" Value="未连接">
                                                <Setter Property="Fill" Value="#8B7D68" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=AgentStateText}" Value="已暂停">
                                                <Setter Property="Fill" Value="#AF782C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock x:Name="AgentStateText" Text="未连接" FontWeight="SemiBold" Foreground="{StaticResource Pine}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="ActivityText" Text="启动后，请在游戏中选择单人存档。" FontSize="12"
                           Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight" LineHeight="16" MaxHeight="32"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="AgentNextStep" Foreground="{StaticResource MutedInk}" FontSize="11"
                           Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           LineStackingStrategy="BlockLineHeight" LineHeight="14" MaxHeight="28"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="PartnerStatus" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
