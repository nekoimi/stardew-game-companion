<Window x:Class="StardewAI.Companion.Desktop.PluginCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="在线插件目录" Width="680" Height="490" MinWidth="520" MinHeight="370" WindowStartupLocation="CenterOwner"
        Style="{StaticResource CompanionDialogWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PagePaper}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="目录地址" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBox x:Name="CatalogUrl" Grid.Column="1" AutomationProperties.Name="目录 HTTPS 地址" Margin="0,0,9,0" MaxLength="2048" />
                <Button x:Name="LoadCatalog" Grid.Column="2" Content="加载目录" VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButton}" Margin="0" Click="LoadClicked" />
            </Grid>
        </Border>
        <ListView x:Name="CatalogRows" Grid.Row="1" Margin="0,12,0,9" SelectionChanged="EntrySelected"
                  Background="{StaticResource Paper}" BorderBrush="{StaticResource PaperEdge}" AutomationProperties.Name="目录插件">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="插件" Width="175" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="发布者" Width="130" DisplayMemberBinding="{Binding Publisher}" />
                    <GridViewColumn Header="版本" Width="90" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="兼容性" Width="95" DisplayMemberBinding="{Binding Compatibility}" />
                </GridView>
            </ListView.View>
        </ListView>
        <DockPanel Grid.Row="2">
            <Button x:Name="ApplyVersion" DockPanel.Dock="Right" Content="安装或更新" IsEnabled="False" Click="ApplyClicked"
                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
            <TextBlock x:Name="CatalogFeedback" VerticalAlignment="Center" Style="{StaticResource InlineFeedback}" />
        </DockPanel>
    </Grid>
</Window>
