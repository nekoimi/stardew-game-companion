<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>星露谷游戏伴侣</AssemblyName>
    <RootNamespace>StardewAI.Companion.Desktop</RootNamespace>
    <Product>星露谷游戏伴侣</Product>
    <ApplicationIcon>Assets/companion.ico</ApplicationIcon>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../../shared/dotnet/FileLogger.cs" Link="Logging/FileLogger.cs" />
    <Compile Include="../../shared/dotnet/Updates/*.cs" Link="Updates/%(Filename)%(Extension)" />
    <Using Remove="System.Drawing;System.Windows.Forms" />
    <Resource Include="Assets/*.png;Assets/companion.ico" />
    <None Include="$(MSBuildToolsPath)/../../LICENSE.txt" Link="DotNet-LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"
          Condition="Exists('$(MSBuildToolsPath)/../../LICENSE.txt')" />
    <None Include="$(MSBuildToolsPath)/../../ThirdPartyNotices.txt" Link="DotNet-ThirdPartyNotices.txt"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true"
          Condition="Exists('$(MSBuildToolsPath)/../../ThirdPartyNotices.txt')" />
  </ItemGroup>
</Project>
