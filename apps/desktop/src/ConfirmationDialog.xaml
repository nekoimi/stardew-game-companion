<Window x:Class="StardewAI.Companion.Desktop.ConfirmationDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="星露谷游戏伴侣" Width="438" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Style="{StaticResource CompanionDialogWindow}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,18" />
        <CheckBox x:Name="Option" Visibility="Collapsed" IsChecked="True" Margin="0,0,0,18" />
        <WrapPanel HorizontalAlignment="Right">
            <Button x:Name="CancelCloseButton" Content="取消" IsCancel="True" IsDefault="True" />
            <Button x:Name="AlternateButton" Visibility="Collapsed" Click="AlternateClicked" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="ConfirmButton" Click="ConfirmClicked" Margin="0" />
        </WrapPanel>
    </StackPanel>
</Window>
