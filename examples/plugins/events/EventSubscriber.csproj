<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildToolsPath)/../../LICENSE.txt" Link="DotNet-LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="$(MSBuildToolsPath)/../../ThirdPartyNotices.txt" Link="DotNet-ThirdPartyNotices.txt"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
