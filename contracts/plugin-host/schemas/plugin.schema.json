{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stardew Game Companion plugin manifest v1",
  "type": "object",
  "required": [
    "manifestVersion",
    "id",
    "name",
    "publisher",
    "version",
    "platform",
    "hostProtocol",
    "entry",
    "fileManifest"
  ],
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 72,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[a-zA-Z0-9]+(?:[.-][a-zA-Z0-9]+)*)?$"
    },
    "platform": {
      "const": "win-x64"
    },
    "hostProtocol": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "executable",
        "args",
        "workingDirectory"
      ],
      "properties": {
        "executable": {
          "$ref": "#/$defs/path",
          "pattern": "\\.[Ee][Xx][Ee]$"
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "workingDirectory": {
          "anyOf": [
            {
              "const": "."
            },
            {
              "$ref": "#/$defs/path"
            }
          ]
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "local-web"
        }
      }
    },
    "fileManifest": {
      "const": "files.json"
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/\\\\:*?\"<>|\\u0000-\\u001f]+(?:/[^/\\\\:*?\"<>|\\u0000-\\u001f]+)*$"
    }
  }
}
