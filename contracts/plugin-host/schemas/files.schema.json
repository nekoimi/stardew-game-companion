{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stardew Game Companion plugin file list v1",
  "type": "object",
  "required": [
    "files"
  ],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "plugin.schema.json#/$defs/path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
